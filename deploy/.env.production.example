# Variables de production MAXI EQUIP — VPS (docker-compose.yml).
# Copier ce fichier en deploy/.env.production et remplir les vraies
# valeurs. NE JAMAIS committer deploy/.env.production (déjà couvert par
# la règle .gitignore "*.env" du dépôt — vérifier qu'elle s'applique bien
# à ce chemin avant le premier déploiement réel).

# ── PostgreSQL (interne au réseau Docker, jamais exposé publiquement) ──
POSTGRES_USER=maxiequip
POSTGRES_PASSWORD=
POSTGRES_DB=maxiequip_production

# ── API ──
# Secret de signature des JWT applicatifs (installation) — générer une
# vraie valeur aléatoire longue, jamais une phrase mémorisable. Ex. :
#   openssl rand -hex 32
JWT_SIGNING_SECRET=

# URL PUBLIQUE de l'API elle-même (jamais l'adresse interne Docker) —
# utilisée pour construire les URLs d'images renvoyées aux clients.
PUBLIC_API_BASE_URL=https://api.maxi-equip.com

# Origines autorisées à appeler l'API depuis un navigateur (site public) —
# jamais de wildcard "*" en production (voir core/cors.ts).
CORS_ALLOWED_ORIGINS=https://maxi-equip.com,https://www.maxi-equip.com

# ── Site (valeur figée AU BUILD de l'image Docker, voir packages/site/Dockerfile) ──
NEXT_PUBLIC_API_BASE_URL=https://api.maxi-equip.com

# ── Sauvegarde cloud Backblaze B2 — PC SHOP UNIQUEMENT ──
# CLOUD_BACKUP_* (bucket, région, clé API B2, endpoint) ne sont PAS des
# variables de ce serveur — elles se configurent comme variables
# d'environnement WINDOWS sur le PC Shop lui-même (voir
# packages/electron-app/.env.example), pour la sauvegarde de la base
# SQLite locale. Aucune trace ici, jamais dupliquées par erreur.

# ── Récupération d'installation — clé B2 EN LECTURE (voir
# core/b2Presigner.ts) — DISTINCTE de la clé d'écriture du PC Shop
# ci-dessus, jamais la même clé des deux côtés. Utilisée pour générer des
# URLs de téléchargement présignées vers la dernière sauvegarde SQLite
# lors d'une restauration après vol/panne du PC Shop.
RECUPERATION_B2_BUCKET=maxiequip-backups
RECUPERATION_B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
RECUPERATION_B2_KEY_ID=
RECUPERATION_B2_APPLICATION_KEY=

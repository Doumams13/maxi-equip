{
  "name": "maxi-equip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MAXI EQUIP — Application de gestion de stock (SHOP) + site vitrine. Monorepo.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "install:all": "npm install",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --workspaces --if-present",
    "check:isolation": "node scripts/check-isolation.js",
    "check:all": "npm run typecheck && npm run lint && npm run check:isolation && npm run test",
    "dev:electron": "npm run dev --workspace=@maxi-equip/electron-app",
    "dev:site": "npm run dev --workspace=@maxi-equip/site",
    "dev:api": "npm run dev --workspace=@maxi-equip/api"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0",
    "vite": "5.4.21",
    "electron": "28.3.3"
  },
  "overrides": {
    "vite": "5.4.21",
    "electron": "28.3.3"
  }
}

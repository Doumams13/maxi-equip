# Copier ce fichier en .env pour le développement local.
# Aucune valeur réelle ne doit être committée dans Git (voir .gitignore).

# URL de l'API pour la synchronisation (Synthèse §7). Deux valeurs
# distinctes attendues selon l'environnement (TEST vs PRODUCTION) —
# jamais la même base de données pour les deux (Synthèse §12).
MAXI_EQUIP_API_URL=http://localhost:8787
MAXI_EQUIP_ENV=test

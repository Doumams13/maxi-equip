# Copier ce fichier en .env pour le développement local.
# Aucune valeur réelle ne doit être committée dans Git (voir .gitignore).

# URL de l'API pour la synchronisation (Synthèse §7). Deux valeurs
# distinctes attendues selon l'environnement (TEST vs PRODUCTION) —
# jamais la même base de données pour les deux (Synthèse §12).
MAXI_EQUIP_API_URL=http://localhost:8787
MAXI_EQUIP_ENV=test

# Jeton d'installation (JWT) émis hors ligne via
# packages/api/src/scripts/emettre-jwt-installation.ts (Phase 3.5.1) —
# une valeur par poste/installation, jamais partagée, jamais committée.
# Sans elle, la synchronisation reste inactive (voir syncConfig.ts) mais
# le reste de l'application fonctionne normalement (offline-first).
# MAXI_EQUIP_SYNC_JWT=

# Backup cloud (Bloc 4, remédiation pré-production) — entièrement
# optionnel : sans CES QUATRE variables, aucun envoi cloud n'est
# tenté (voir main/index.ts, envoyerBackupVersCloudSiConfigure) — le
# backup local existant continue de fonctionner à l'identique.
# Compatible AWS S3 réel ou tout service compatible S3 (MinIO, Backblaze
# B2, DigitalOcean Spaces...) via CLOUD_BACKUP_ENDPOINT.
# CLOUD_BACKUP_BUCKET=
# CLOUD_BACKUP_REGION=
# CLOUD_BACKUP_ACCESS_KEY_ID=
# CLOUD_BACKUP_SECRET_ACCESS_KEY=
# Renseigné uniquement pour un fournisseur S3-compatible auto-hébergé (absent pour AWS S3 réel) :
# CLOUD_BACKUP_ENDPOINT=
# CLOUD_BACKUP_FORCE_PATH_STYLE=true

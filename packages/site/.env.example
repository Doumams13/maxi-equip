# Copier ce fichier en .env.local pour le développement local.
# Aucune valeur réelle ne doit être committée dans Git (voir .gitignore).

# URL de l'API — appelée uniquement depuis le serveur Next.js, jamais
# depuis le navigateur du visiteur (Synthèse §4/§5). Ne PAS préfixer cette
# variable par NEXT_PUBLIC_, ce qui l'exposerait au client.
API_BASE_URL=http://localhost:8787
